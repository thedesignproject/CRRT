{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationDir": null,
    "outDir": null,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "feedback-widget": ["./src/index.ts"],
      "@widget/*": ["./src/*"],
      "@crrt/ui/*": ["./packages/ui/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "api", "apps/dashboard", "apps/landing", "apps/extension", "workflows", "server"]
}
