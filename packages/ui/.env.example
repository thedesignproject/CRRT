# CRRT feedback panel — the Storybook "🥕 CRRT" panel.
# Copy this file to `.env` and fill in the values to send feedback to a CRRT project.
# Without STORYBOOK_CRRT_PROJECT_ID the panel just shows a setup notice.

# The CRRT project's public key (required to send).
STORYBOOK_CRRT_PROJECT_ID=

# Backend base URL. Leave as-is unless pointing at a self-hosted CRRT.
STORYBOOK_CRRT_API_BASE=https://crrt.ai/api
