{
  "name": "@crrt/ui",
  "version": "0.0.0",
  "private": true,
  "description": "CRRT Studio design system: tokens, primitives and CRRT patterns. Consumed as source by apps/dashboard.",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./tokens/tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:diff-coverage": "bash scripts/diff-coverage.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.0",
    "@thedesignproject/crrt": "0.3.16",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.4",
    "happy-dom": "^20.9.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.4"
  }
}
