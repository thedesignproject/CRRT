# Demo app — base URL of the feedback-widget API (your own deployment)
VITE_API_BASE=https://your-deployment.vercel.app/api

# Demo app — project namespace for comments
VITE_PROJECT_ID=demo-project

# Supabase — URL + anon (publishable) key.
# SUPABASE_KEY is the anon key: baked into the dashboard bundle at build time
# (see apps/dashboard/vite.config.ts) and also used server-side by api/_lib/supabase.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Required server-side for resolving project member emails from Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server — Postgres connection string for Drizzle migrations (schema management only).
# Use Direct connection (port 5432) from Supabase dashboard → Project Settings → Database.
# Required at build time so `deploy-build` can apply pending migrations before deploy.
DATABASE_URL=postgres://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Reviewer API access token for the private dashboard
REVIEWER_API_TOKEN=replace-me

# Used to encrypt per-share bearer tokens for prompt generation
SHARE_TOKEN_SECRET=replace-me-with-a-long-random-string

# Used when generating tokenized share URLs inside prompts
APP_URL=http://localhost:3000

# Optional comment activity emails via Resend.
# Sender must be under a verified Resend domain, e.g. mail.crrt.ai.
RESEND_API_KEY=
COMMENT_ACTIVITY_EMAIL_FROM=CRRT <activity@mail.crrt.ai>
COMMENT_ACTIVITY_EMAIL_COOLDOWN_HOURS=5
COMMENT_ACTIVITY_EMAIL_TIMEOUT_MS=5000

# Product Audit — disabled unless explicitly enabled.
AUDIT_FEATURE_ENABLED=false
AUDIT_ANONYMOUS_ENABLED=false
AUDIT_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
# Local-only escape hatch used by scripts/local-api.ts; never enable in production.
AUDIT_LOCAL_EXECUTION=false

# Existing OpenAI-compatible model configuration. AI_MODEL is the Verifier
# model and the fallback when AI_CRITIC_MODEL is omitted.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_CRITIC_MODEL=openai/gpt-oss-20b

# Optional Product Audit safety budgets and bounded provider retries.
AUDIT_MAX_ROUTES=5
AUDIT_MAX_ACTIONS=20
AUDIT_WALL_CLOCK_MS=300000
AUDIT_MODEL_TOKENS=8000
AUDIT_MAX_ARTIFACTS=10
AUDIT_MODEL_TIMEOUT_MS=45000
AUDIT_MODEL_ATTEMPTS=3
