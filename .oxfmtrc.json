{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "all",
  "ignorePatterns": [
    "supabase/legacy/**",
    "db/migrations/**",
    "apps/landing/public/**",
    "**/*.generated.ts",
    "scripts/test-durations.json",
    "bun.lock",
    "**/package-lock.json"
  ]
}
