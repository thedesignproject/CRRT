{
  "name": "@thedesignproject/crrt",
  "version": "0.3.14",
  "description": "CRRT 🥕 visual feedback capture for React apps",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedesignproject/CRRT.git"
  },
  "homepage": "https://crrt.ai",
  "bugs": {
    "url": "https://github.com/thedesignproject/CRRT/issues"
  },
  "type": "module",
  "main": "dist/crrt.umd.js",
  "module": "dist/crrt.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/crrt.es.js",
      "require": "./dist/crrt.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config apps/landing/vite.config.ts",
    "dev:landing": "vite --config apps/landing/vite.config.ts",
    "dev:dashboard": "bash -c 'trap \"kill 0\" EXIT INT TERM; bunx vercel dev --listen 3000 & vite --config apps/dashboard/vite.config.ts'",
    "dev:dashboard:ui-only": "vite --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc && vite build",
    "build:dashboard": "vite build --config apps/dashboard/vite.config.ts",
    "preview": "vite preview",
    "preview:dashboard": "vite preview --config apps/dashboard/vite.config.ts",
    "prepublishOnly": "npm run build",
    "local": "bun run build && bunx vercel dev",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun db/seed.ts",
    "db:baseline": "bun db/baseline.ts",
    "vercel-build": "bun run typecheck && vite build --config apps/landing/vite.config.ts && vite build --config apps/dashboard/vite.config.ts && bun run db:migrate"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vercel/node": "^5.7.12",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.9.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.4"
  }
}
